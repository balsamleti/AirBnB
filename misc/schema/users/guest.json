{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "age": {
      "type": "integer",
      "minimum": 0
    },
    "gender": {
      "type": "string",
      "enum": ["male", "female", "other"]
    }
  },
  "required": ["id", "name", "age", "gender"],
  "additionalProperties": false
}
