{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/booking.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "roomsCount": {
      "type": "integer",
      "minimum": 1
    },
    "checkInDate": {
      "type": "string",
      "format": "date"
    },
    "checkOutDate": {
      "type": "string",
      "format": "date"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "bookingStatus": {
      "type": "string",
      "enum": ["CREATED", "CONFIRMED", "CANCELLED", "COMPLETED"]
    },
    "guests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./guest.json"
      }
    },
    "amount": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "roomsCount",
    "checkInDate",
    "checkOutDate",
    "createdAt",
    "bookingStatus",
    "guests",
    "amount"
  ],
  "additionalProperties": false
}
